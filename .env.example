# Pathlo Environment Variables
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to version control.

# Groq API Key – get a FREE key at https://console.groq.com/keys
# Format: VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx  (no spaces, no quotes)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Groq Model – optional, defaults to llama-3.3-70b-versatile
# Options: llama-3.3-70b-versatile, llama3-8b-8192, mixtral-8x7b-32768, gemma2-9b-it
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Authentication – get free keys at https://app.supabase.com/
# 1. Create a new Supabase project
# 2. Go to Project Settings > API Keys
# 3. Copy Project URL and Anon Key (public key, safe to expose in frontend)
# Format: VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Format: VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (long JWT key)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
